# Файл для хранения личных данных, ключей и токенов
# Данные необходимо указывать в файле с именем ".env"
# Укажите текстом соответствующее значение без пробелов после знака "="

MY_SECRET_KEY=django-insecure-...
DEBUG=булевое значение (True/False)

DB_NAME=имя БД
DB_USER=имя пользователя БД
DB_PASSWORD=пароль пользователя БД
DB_HOST=хост (url-адрес) БД
DB_PORT=порт БД